{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug, everything on, warnings as errors",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FUSE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "dev + AddressSanitizer + UBSan",
      "inherits": "dev",
      "cacheVariables": { "FUSE_SANITIZERS": "address;undefined" }
    },
    {
      "name": "core-only",
      "displayName": "Core libraries only (no OCCT)",
      "inherits": "dev",
      "cacheVariables": { "FUSE_WITH_OCCT": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "core-only", "configurePreset": "core-only" }
  ],
  "testPresets": [
    { "name": "base", "hidden": true, "output": { "outputOnFailure": true } },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "core-only", "inherits": "base", "configurePreset": "core-only" }
  ]
}

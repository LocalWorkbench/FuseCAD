# End-to-end check of the CLI: create, inspect, re-parameterise and export.
function(run)
    execute_process(COMMAND ${CLI} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "oc-cli ${ARGN} failed (${rc}):\n${out}\n${err}")
    endif()
    set(LAST_OUTPUT "${out}" PARENT_SCOPE)
endfunction()

set(doc ${WORKDIR}/smoke.ocd)
run(new ${doc} --sample plate)
run(info ${doc})
if(NOT LAST_OUTPUT MATCHES "Body1")
    message(FATAL_ERROR "info output is missing Body1:\n${LAST_OUTPUT}")
endif()
run(export ${doc} ${WORKDIR}/smoke.step -p width=100mm -p hole_d=12mm)
run(export ${doc} ${WORKDIR}/smoke.stl)
foreach(f smoke.step smoke.stl)
    if(NOT EXISTS ${WORKDIR}/${f})
        message(FATAL_ERROR "${f} was not written")
    endif()
endforeach()

execute_process(COMMAND ${CLI} info ${WORKDIR}/missing.ocd RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
    message(FATAL_ERROR "info on a missing file should fail")
endif()
